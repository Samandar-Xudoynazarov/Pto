# MongoDB Atlas ulanish qatori (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://FOYDALANUVCHI:PAROL@cluster0.xxxxx.mongodb.net/pto?retryWrites=true&w=majority

# Birinchi kirish paroli: bazada foydalanuvchi bo'lmaganda "admin" login va shu parol bilan kiriladi,
# administrator avtomatik yaratiladi. Keyin foydalanuvchilar ilova ichida boshqariladi.
APP_PASSWORD=bu-yerga-kuchli-parol

# Kirish tokenlarini imzolash kaliti — uzun tasodifiy satr. O'zgartirilsa, hamma qaytadan kiradi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Frontend manzili (vergul bilan bir nechta). Masalan: https://pto-frontend.vercel.app
CORS_ORIGIN=https://pto-frontend.vercel.app

PORT=4000
